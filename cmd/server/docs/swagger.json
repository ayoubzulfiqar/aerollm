{
    "swagger": "2.0",
    "info": {
        "description": "AeroLLM is a high-performance, multi-provider LLM gateway that serves as a drop-in replacement for the LiteLLM proxy. It supports 100+ LLM providers with advanced routing, virtual keys, semantic caching, spend analytics, and async observability callbacks.",
        "title": "AeroLLM API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "AeroLLM Contributors",
            "url": "https://github.com/ayoubzulfiqar/aerollm",
            "email": "contact@ayoubzulfiqar.com"
        },
        "license": {
            "name": "MIT",
            "url": "https://github.com/ayoubzulfiqar/aerollm/blob/main/LICENSE"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/config/update": {
            "post": {
                "description": "Accepts a partial or full config (JSON), validates it, and hot-reloads the provider registry without dropping active connections.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "config"
                ],
                "summary": "Update config",
                "parameters": [
                    {
                        "description": "Updated configuration",
                        "name": "req",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/config.Config"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/config/yaml": {
            "get": {
                "description": "Returns the current active configuration with all secrets masked.",
                "tags": [
                    "config"
                ],
                "summary": "Get config YAML",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/global/spend/logs": {
            "get": {
                "description": "Returns paginated, detailed transaction logs for a specific key or customer.",
                "tags": [
                    "analytics"
                ],
                "summary": "Get spend logs",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filter by api_key, customer_id, or team_id",
                        "name": "filter",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Page number (default 1)",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Entries per page (default 50, max 500)",
                        "name": "page_size",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/analytics.SpendLogsResponse"
                        }
                    }
                }
            }
        },
        "/global/spend/report": {
            "get": {
                "description": "Aggregates spend over a time range, grouped by api_key, customer, team, or model.",
                "tags": [
                    "analytics"
                ],
                "summary": "Get spend report",
                "parameters": [
                    {
                        "type": "string",
                        "description": "RFC3339 start timestamp",
                        "name": "start",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "RFC3339 end timestamp",
                        "name": "end",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Group by: api_key, customer, team, model",
                        "name": "group_by",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Optional filter value",
                        "name": "filter",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/analytics.SpendReport"
                        }
                    }
                }
            }
        },
        "/key/delete": {
